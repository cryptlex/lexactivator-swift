<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Privacy manifest for the LexActivator Swift package.

        The native library is linked statically, so its API usage becomes part
        of the host app's binary and has to be declared. Shipping the manifest
        here means an app adopting this package does not have to work out the
        declarations itself.

        NSPrivacyAccessedAPITypes below reflects a symbol scan of the shipped
        binary: it references stat and fstat (File Timestamp category), and no
        disk-space, user-defaults, system-boot-time or active-keyboard APIs.

        NSPrivacyCollectedDataTypes is deliberately absent. What the Cryptlex
        service records about a device or user is a question for Cryptlex, not
        something that can be read off the binary — see the iOS notes in
        README.md before submitting to the App Store.
    -->
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- C617.1: timestamps of files inside the app container. The
                     library reads metadata of its own activation data store. -->
                <string>C617.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
